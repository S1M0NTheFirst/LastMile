# Copy to .env on each machine and fill in the OTHER machine's LAN IP.
#   Mac:     ipconfig getifaddr en0
#   Windows: ipconfig
#   Linux:   hostname -I

# On machine A (runs docker-compose.yml): machine B's IP
MACHINE_B_IP=192.168.1.50

# On machine B (runs docker-compose.machine-b.yml): machine A's IP
MACHINE_A_IP=192.168.1.132
